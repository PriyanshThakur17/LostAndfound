# =============================================
# Campus Lost & Found — Backend Environment
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to Git.
# =============================================

PORT=5000

# MongoDB connection URI (supplied by Member 3)
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Long, random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Must match the Vite dev server origin (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# 'development' | 'production'
NODE_ENV=development
