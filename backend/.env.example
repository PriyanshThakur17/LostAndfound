# =============================================
# Campus Lost & Found — Backend Environment
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to Git.
# =============================================

PORT=5000

# MongoDB connection URI (Member 3 database: campus_lost_found)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found
MONGO_URI=mongodb://127.0.0.1:27017/campus_lost_found

# Long, random string used to sign JWTs
JWT_SECRET=supersecretcampuslostandfoundjwtkey2026
JWT_EXPIRES_IN=7d

# Must match the Vite dev server origin (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# 'development' | 'production'
NODE_ENV=development
